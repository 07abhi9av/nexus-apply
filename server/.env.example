# ================================================================
# INGRESS COMPUTE BACKEND ENVIRONMENT CONFIGURATION
# ================================================================

# Server Port (Default: 4000)
PORT=4000

# Environment: 'production' or 'development'
NODE_ENV=production

# Permitted CORS Origins (comma-separated for multiple origins, or '*' for public API)
# In production, set this to your frontend URL(s):
# Example: https://ingress.dev,https://nexus-apply.vercel.app
CORS_ORIGIN=*

# ----------------------------------------------------------------
# Optional: SMTP Configuration for Dispatch Confirmation Emails
# Compatible with SendGrid, Resend, Amazon SES, Brevo, Gmail SMTP
# If omitted, delivery receipts are saved locally to data/emails/
# ----------------------------------------------------------------
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key_here
# SMTP_FROM="in.gress Career Portals" <alerts@yourdomain.com>
